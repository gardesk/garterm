--------------------------------------------------------------------------------
-- TERMINAL API REFERENCE
--------------------------------------------------------------------------------
-- These functions are available in keybind callbacks:
--
-- gar.terminal.new_tab({ cwd, cmd, title })
--     Create a new tab. Returns tab_id.
--     - cwd: Working directory (optional)
--     - cmd: Command to run after shell prompt (optional)
--     - title: Tab title (optional, usually set by shell)
--
-- gar.terminal.split({ direction, cwd, cmd })
--     Split the focused pane. Returns pane_id.
--     - direction: "horizontal" or "vertical"
--     - cwd: Working directory (optional)
--     - cmd: Command to run after shell prompt (optional)
--
-- gar.terminal.send_text(pane_id, text)
--     Send text to a pane. Use nil for focused pane.
--
-- gar.terminal.close_tab(tab_id)
--     Close a tab. Use nil for active tab.
--
-- gar.terminal.close_pane(pane_id)
--     Close a pane. Use nil for focused pane.
--
-- gar.terminal.focus_tab(n)
--     Focus tab by index (1-based).
--
-- gar.terminal.focus_pane(pane_id)
--     Focus a specific pane by ID.
--
-- gar.terminal.focus_direction(dir)
--     Focus pane in direction: "up", "down", "left", "right"
--
-- gar.terminal.next_tab() / gar.terminal.prev_tab()
--     Cycle through tabs.
--
-- gar.terminal.load_session(name)
--     Load a named session from gar.terminal.sessions.
